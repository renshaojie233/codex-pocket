[Unit]
Description=Share the physical workstation desktop over an SSH-only VNC endpoint
After=display-manager.service
Wants=display-manager.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/sbin/codex-pocket-x11vnc-workstation
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
