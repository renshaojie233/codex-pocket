<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.codexpocket.bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/false</string>
        <string>/path/to/codex-pocket/bridge/src/server.mjs</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/path/to/codex-pocket/bridge</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>NetworkState</key>
        <true/>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/path/to/codex-pocket/bridge/data/bridge.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/codex-pocket/bridge/data/bridge-error.log</string>
</dict>
</plist>
